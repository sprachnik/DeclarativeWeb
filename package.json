{
  "name": "declarativeweb",
  "version": "0.0.1-beta",
  "description": "A minimal, LLM-friendly JavaScript library for rendering websites from JSON",
  "main": "render.js",
  "scripts": {
    "build": "node build.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=6144' jest --ci --coverage --runInBand --silent --noStackTrace"
  },
  "keywords": [
    "static-site",
    "json",
    "llm",
    "framework",
    "no-build"
  ],
  "author": "James Stalley-Moores",
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/jest": "^29.5.11",
    "esbuild": "^0.27.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "render.js",
      "form-gen.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "clover",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 55,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
